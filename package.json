{
  "name": "family-health-map",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:next": "next dev",
    "build": "vinext build",
    "build:vercel": "next build",
    "vercel-build": "next build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "start:next": "next start",
    "typecheck": "tsc --project tsconfig.check.json --noEmit --incremental false",
    "test": "vitest run",
    "lint": "oxlint app components/*.tsx lib types tests",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@supabase/supabase-js": "^2.115.0",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "next": "16.4.3",
    "openai": "^7.10.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "oxfmt": "0.75.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "wrangler": "4.154.0",
    "vitest": "5.0.5"
  },
  "type": "module",
  "description": "Bilingual family health history demo with deterministic patterns, an interactive family tree, and local summaries.",
  "overrides": {
    "wrangler": "$wrangler",
    "undici": "^7.30.1",
    "fflate": "0.8.3"
  }
}
